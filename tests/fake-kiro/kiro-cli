#!/usr/bin/env python3
"""Deterministic PTY peer. Never reads Kiro state, credentials, or a network."""
import json
import os
import signal
import sys
import time
import tty

# Agent discovery fixtures for the picker flows. The fixture file holds
# {"agents": [{"name": "..."}]}; an unset fixture lists no agents and any
# named agent stays acceptable, preserving older smoke behavior.
FIXTURE = os.environ.get("KIRO_AGENTS_FAKE_AGENT_FIXTURE", "")


def fixture_names():
    with open(FIXTURE) as handle:
        payload = json.load(handle)
    return [agent["name"] for agent in payload["agents"]]


if sys.argv[1:3] == ["agent", "list"]:
    assert sys.argv[3:5] == ["--format", "json-pretty"], sys.argv
    delay = float(os.environ.get("KIRO_AGENTS_FAKE_AGENT_LIST_DELAY", "0"))
    if delay:
        time.sleep(delay)
    try:
        names = fixture_names() if FIXTURE else []
    except (OSError, ValueError, KeyError, TypeError) as error:
        sys.stderr.write(f"fake: agent listing failed: {error}\n")
        sys.exit(3)
    print(json.dumps({"agents": [{"name": name} for name in names]}, indent=2))
    sys.exit(0)

assert sys.argv[1:4] == ["chat", "--v2", "--tui"], sys.argv
assert "--trust-all-tools" not in sys.argv
assert "--resume-id" not in sys.argv
agent = sys.argv[sys.argv.index("--agent") + 1] if "--agent" in sys.argv else None
if agent == "missing":
    sys.exit(4)
if FIXTURE and agent is not None and agent not in fixture_names():
    # Mirrors Kiro's exit code 4 for a profile the resolver does not offer.
    sys.stderr.write("fake: agent not found\n")
    sys.exit(4)
tty.setraw(0)


def size(*_):
    dims = os.get_terminal_size(0)
    os.write(1, f"SIZE:{dims.columns}x{dims.lines}\n".encode())


signal.signal(signal.SIGWINCH, size)
os.write(
    1,
    f"\x1b[32mREADY:{os.getpid()}:{os.getcwd()}:{agent or 'default'}\x1b[0m\n".encode(),
)
while True:
    data = os.read(0, 4096)
    if not data:
        break
    if data == b"exit":
        os.write(1, b"GOODBYE\n")
        break
    if data == b"flood":
        for _ in range(640):
            os.write(1, b"x" * 4096)
        os.write(1, b"FLOOD_DONE\n")
    elif data == b"screen":
        # Native TUI screen ownership: alternate screen, mouse, bracketed
        # paste. The handoff cleanup must undo these without leaving alt.
        os.write(1, b"\x1b[?1049h\x1b[?2004h\x1b[?1000h\x1b[?1006hNATIVE\x1b[0m\n")
    elif data == b"leave":
        os.write(1, b"\x1b[?1049l\x1b[?2004l\x1b[?1000l\x1b[?1006lLEFT\x1b[0m\n")
    else:
        os.write(1, b"BYTES:" + data.hex().encode() + b"\n")
